{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": false,
    "types": ["node", "bun-types/test"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["server.ts", "host.ts", "app.tsx", "types", "components", "hooks", "lib", "test"]
}
